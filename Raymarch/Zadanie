<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDF Operations</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    background: #090b10;
    overflow: hidden;
    font-family: Arial, Helvetica, sans-serif;
  }
  canvas { display: block; }
  .controls {
    position: fixed;
    top: 18px;
    left: 18px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  button {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(18, 24, 34, 0.82);
    color: #f6f7fb;
    padding: 9px 13px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
  }
  button.active {
    background: #f2b84b;
    color: #15120a;
    border-color: #f8d384;
  }
</style>
</head>
<body>
<div class="controls" aria-label="Operacja SDF">
  <button class="active" data-operation="0" type="button">Suma</button>
  <button data-operation="1" type="button">Przecięcie</button>
  <button data-operation="2" type="button">Różnica</button>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js"
  }
}
</script>
<script type="module">
import * as THREE from 'three';

const scene = new THREE.Scene();
const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);
document.body.appendChild(renderer.domElement);

const vertexShader = `
void main() {
  gl_Position = vec4(position, 1.0);
}
`;

const fragmentShader = `
uniform vec2 u_resolution;
uniform float u_time;
uniform int u_operation;

float sdCircle(vec2 p, float r) {
  return length(p) - r;
}

float sdBox(vec2 p, vec2 b) {
  vec2 q = abs(p) - b;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

mat2 rotate2d(float a) {
  float s = sin(a);
  float c = cos(a);
  return mat2(c, -s, s, c);
}

float combineSdf(float a, float b) {
  if (u_operation == 0) {
    return min(a, b);
  }
  if (u_operation == 1) {
    return max(a, b);
  }
  return max(a, -b);
}

vec3 shapeColor(float circle, float box) {
  vec3 circleColor = vec3(0.18, 0.68, 0.95);
  vec3 boxColor = vec3(0.96, 0.36, 0.28);
  vec3 overlapColor = vec3(0.42, 0.86, 0.38);

  if (u_operation == 1) {
    return overlapColor;
  }
  if (u_operation == 2) {
    return circleColor;
  }
  return circle < box ? circleColor : boxColor;
}

void main() {
  vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution) / u_resolution.y;
  float t = u_time;

  vec2 circleCenter = vec2(0.34 * sin(t * 0.9), 0.18 * sin(t * 1.7));
  float circle = sdCircle(uv - circleCenter, 0.36);

  vec2 boxP = uv - vec2(0.16 * cos(t * 0.7), 0.02 * sin(t * 1.2));
  boxP = rotate2d(t * 0.8) * boxP;
  vec2 boxSize = vec2(0.44 + 0.11 * sin(t * 1.4), 0.20 + 0.07 * cos(t * 1.1));
  float box = sdBox(boxP, boxSize);

  float d = combineSdf(circle, box);
  vec3 background = vec3(0.08, 0.11, 0.10);
  vec3 insideColor = shapeColor(circle, box);

  vec3 col = mix(background, insideColor, step(d, 0.0));

  gl_FragColor = vec4(pow(col, vec3(0.4545)), 1.0);
}
`;

const geometry = new THREE.PlaneGeometry(2, 2);
const material = new THREE.ShaderMaterial({
  vertexShader,
  fragmentShader,
  uniforms: {
    u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
    u_time: { value: 0.0 },
    u_operation: { value: 0 }
  }
});

scene.add(new THREE.Mesh(geometry, material));

window.addEventListener('resize', () => {
  renderer.setSize(window.innerWidth, window.innerHeight);
  material.uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight);
});

document.querySelectorAll('button[data-operation]').forEach((button) => {
  button.addEventListener('click', () => {
    material.uniforms.u_operation.value = Number(button.dataset.operation);
    document.querySelectorAll('button[data-operation]').forEach((item) => {
      item.classList.toggle('active', item === button);
    });
  });
});

const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  material.uniforms.u_time.value = clock.getElapsedTime();
  renderer.render(scene, camera);
}
animate();
</script>
</body>
</html>
